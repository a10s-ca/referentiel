{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://datascene.ca/modele/geographic_relation.schema.json",
  "title": "Association Géographique (GeographicRelation)",
  "description": "Permet d'associer des lieux au contributeur, par exemple pour indiquer le lieu de naissance, de décès, le lieu du siège social, etc.\n\n[Voir le vocabulaire suggéré](../vocabularies/associationGeographiqueType/)",
  "required": [
    "type"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "GeographicRelation"
    },
    "relationType": {
      "$ref": "term.schema.json",
      "title": "Type de relation"
    },
    "addressCountry": {
      "$ref": "./datatypes/country_code.schema.json",
      "title": "Pays"
    },
    "addressRegion": {
      "$ref": "./datatypes/text_short.schema.json",
      "title": "Région"
    },
    "addressLocality": {
      "$ref": "./datatypes/text_short.schema.json",
      "title": "Localité"
    }
  }
}
